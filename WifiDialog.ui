    <property name="styleSheet">
     <string notr="true">/* 整个列表控件 */
QListWidget {
    background-color: rgb(35, 35, 35);
    border: none;
    border-radius: 16px;
    color: #ffffff;
    outline: none; /* 去掉选中时的虚线外框 */
}

/* 每一行item（WiFi条目） */
QListWidget::item {
    height: 60px;         /* 行高，调大一点，像卡片 */
    border:1px solid #383e48; /* 条目细边框 */
    border-radius:8px;    /* 条目圆角 */
    margin:4px;           /* 条目之间留出空隙，分开卡片 */
    padding-left:16px;    /* 文字左边留白 */
}

/* 鼠标悬浮在条目上 */
QListWidget::item:hover {
    background-color:#303742;
}

/* 选中当前WiFi条目（蓝色高亮，参考你效果图） */
QListWidget::item:selected {
    background-color:#164b80;
    border:1px solid #2188dd;
    color:white;
}</string>
