   <property name="styleSheet">
    <string notr="true">QCheckBox{
    spacing:10px;
    font-size:16px;
}
/* 外框轨道 */
QCheckBox::indicator{
    width:50px;
    height:26px;
    border-radius:13px;
    background-color:#cccccc;
}
/* 里面圆形滑块 */
QCheckBox::indicator::handle{
    width:22px;
    height:22px;
    border-radius:11px;
    background:white;
}
/* 选中=蓝牙打开，轨道变蓝色 */
QCheckBox::indicator:checked{
    background-color:rgb(53,132,228);
}
QCheckBox::indicator:checked::handle{
    margin-left:24px;  /*滑块往右滑*/
}</string>
   </property>
   <property name="text">
    <string>蓝牙</string>
   </property>
  </widget>
